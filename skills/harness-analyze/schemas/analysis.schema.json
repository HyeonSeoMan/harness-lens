{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HyeonSeoMan/harness-lens/schemas/analysis.schema.json",
  "title": "Harness Lens analysis result",
  "description": "Harness Lens 분석 결과 데이터 계약 v0.1. 작성 주체에 따라 최상위를 나눈다. meta·engine·validation은 엔진이 결정론적으로 계산하고, interpretation만 사용자 LLM이 쓴다. LLM은 수준(level)·범위·지표·변경 목록을 쓰지 않는다. 의미 규칙(참조 무결성, 근거 단일 귀속 등)은 docs/spec/engine-cli.md의 validate 검사 목록을 따른다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rubricVersion", "meta", "engine", "interpretation", "validation"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "rubricVersion": {
      "description": "evaluation-rubric.md 버전. 기준이 다르면 비교를 제한한다(FR-06).",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "meta": { "$ref": "#/$defs/meta" },
    "engine": { "$ref": "#/$defs/engineSection" },
    "interpretation": { "$ref": "#/$defs/interpretation" },
    "validation": { "$ref": "#/$defs/validation" }
  },
  "$defs": {
    "axisId": {
      "description": "평가 축 ID. 순서는 레이더 축 순서와 같고 고정이다.",
      "enum": [
        "spec_clarity",
        "verification_gate_strength",
        "execution_stability",
        "throughput",
        "cost_efficiency",
        "context_efficiency",
        "autonomy",
        "safety_boundary"
      ]
    },
    "evidenceId": { "type": "string", "pattern": "^ev_[0-9a-f]{12}$" },
    "componentId": { "type": "string", "pattern": "^c_[0-9a-f]{12}$" },
    "changeId": { "type": "string", "pattern": "^chg_[0-9a-f]{12}$" },
    "ruleId": {
      "description": "evaluation-rubric.md의 엔진 규칙 ID. 축 규칙 <PREFIX>-L<level>-<nn>, 상한 <PREFIX>-CAP-<nn>, 공통 COM-<nn>, 긴장 T<n>/S<n>.",
      "type": "string",
      "pattern": "^(SC|VG|ES|TP|CE|CX|AU|SB)-(L[0-3]|CAP)-[0-9]{2}$|^COM-[0-9]{2}$|^[TS][0-9]{1,2}$"
    },
    "level": { "type": "integer", "minimum": 0, "maximum": 3 },
    "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "count": { "type": "integer", "minimum": 0 },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "dateTime": { "type": "string", "format": "date-time" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "relPath": {
      "description": "정규화한 POSIX 경로. 프로젝트 파일은 프로젝트 루트 기준 상대 경로, 사용자 파일은 ~/ 로 시작한다. 절대 경로와 .. 는 쓰지 않는다.",
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(~/)?(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\u0000]+$"
    },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 200 },
    "text": { "type": "string", "minLength": 1, "maxLength": 600 },
    "confidence": {
      "description": "근거의 질을 나타내는 등급. 통계적 확률이 아니다. 정의는 analysis-protocol.md.",
      "enum": ["low", "medium", "high"]
    },
    "evidenceIds": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceId" },
      "uniqueItems": true
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "message": { "$ref": "#/$defs/text" }
      }
    },

    "meta": {
      "$comment": "엔진 작성.",
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotId", "analyzedAt", "analysisType", "scope", "configurationHash", "project", "analyzer", "engineInfo"],
      "properties": {
        "snapshotId": {
          "description": "<UTC 시각>-<configurationHash 앞 8자>.",
          "type": "string",
          "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"
        },
        "analyzedAt": { "$ref": "#/$defs/dateTime" },
        "analysisType": {
          "description": "static: 구성만 분석. static_with_sessions: 세션 기록 집계(FR-10)를 함께 사용.",
          "enum": ["static", "static_with_sessions"]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["preset", "sources"],
          "properties": {
            "preset": { "enum": ["project", "project_and_user"] },
            "sources": {
              "description": "실제로 수집 대상에 넣은 설정 출처.",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["project_shared", "project_local", "user", "managed", "plugin"] }
            }
          }
        },
        "configurationHash": { "$ref": "#/$defs/sha256" },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["displayName", "rootPathHash"],
          "properties": {
            "displayName": { "$ref": "#/$defs/shortText" },
            "rootPathHash": { "$ref": "#/$defs/sha256" }
          }
        },
        "analyzer": {
          "description": "해석을 작성한 사용자 에이전트와 모델. 확인할 수 없으면 null.",
          "type": "object",
          "additionalProperties": false,
          "required": ["agent", "model", "modelSource"],
          "properties": {
            "agent": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,39}$" },
            "model": { "type": ["string", "null"], "maxLength": 80 },
            "modelSource": { "enum": ["reported_by_agent", "session_log", "unknown"] }
          }
        },
        "engineInfo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "nodeVersion", "platform", "sessionParserVersion", "pricingTableVersion"],
          "properties": {
            "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
            "nodeVersion": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
            "platform": { "enum": ["darwin", "linux", "win32"] },
            "sessionParserVersion": { "type": ["string", "null"], "pattern": "^[0-9]+$" },
            "pricingTableVersion": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
          }
        }
      }
    },

    "engineSection": {
      "$comment": "엔진 작성. LLM은 읽기만 한다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory", "evidence", "axes", "tensionCandidates", "sessions", "selfCost", "comparison", "limitations"],
      "properties": {
        "inventory": { "$ref": "#/$defs/inventory" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "axes": {
          "description": "8개 축, 고정 순서.",
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/axisResult", "properties": { "axis": { "const": "spec_clarity" } } },
            { "$ref": "#/$defs/axisResult", "properties": { "axis": { "const": "verification_gate_strength" } } },
            { "$ref": "#/$defs/axisResult", "properties": { "axis": { "const": "execution_stability" } } },
            { "$ref": "#/$defs/axisResult", "properties": { "axis": { "const": "throughput" } } },
            { "$ref": "#/$defs/axisResult", "properties": { "axis": { "const": "cost_efficiency" } } },
            { "$ref": "#/$defs/axisResult", "properties": { "axis": { "const": "context_efficiency" } } },
            { "$ref": "#/$defs/axisResult", "properties": { "axis": { "const": "autonomy" } } },
            { "$ref": "#/$defs/axisResult", "properties": { "axis": { "const": "safety_boundary" } } }
          ],
          "minItems": 8,
          "items": false
        },
        "tensionCandidates": {
          "description": "루브릭 긴장·시너지 트리거가 맞은 조합. LLM은 이 목록 안에서만 axisTensions를 쓴다.",
          "type": "array",
          "items": { "$ref": "#/$defs/tensionCandidate" }
        },
        "sessions": { "$ref": "#/$defs/sessions" },
        "selfCost": { "$ref": "#/$defs/selfCost" },
        "comparison": {
          "description": "이전 호환 스냅샷이 없으면 null.",
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/comparison" }]
        },
        "limitations": { "type": "array", "items": { "$ref": "#/$defs/notice" } }
      }
    },

    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components", "sources", "alwaysLoaded", "redactions"],
      "properties": {
        "components": { "type": "array", "items": { "$ref": "#/$defs/component" } },
        "sources": {
          "description": "수집기가 살펴본 위치와 결과(FR-02: 읽지 못한 항목·지원하지 않는 항목 보고).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "origin", "status", "reason"],
            "properties": {
              "path": { "$ref": "#/$defs/relPath" },
              "origin": { "enum": ["project_shared", "project_local", "user", "managed", "plugin"] },
              "status": { "enum": ["read", "absent", "unreadable", "unsupported", "out_of_scope", "skipped_sensitive"] },
              "reason": { "type": ["string", "null"], "maxLength": 200 }
            }
          }
        },
        "alwaysLoaded": {
          "description": "매 세션 상시 로드되는 지침(CLAUDE.md와 @import) 크기. 토큰은 추정값.",
          "type": "object",
          "additionalProperties": false,
          "required": ["files", "lines", "bytes", "estimatedTokens"],
          "properties": {
            "files": { "$ref": "#/$defs/count" },
            "lines": { "$ref": "#/$defs/count" },
            "bytes": { "$ref": "#/$defs/count" },
            "estimatedTokens": { "$ref": "#/$defs/count" }
          }
        },
        "redactions": {
          "description": "제거한 비밀정보 종류별 개수. 값은 기록하지 않는다.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "count"],
            "properties": {
              "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "count": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },

    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "origin", "paths", "contentHash", "attributes"],
      "properties": {
        "id": { "$ref": "#/$defs/componentId" },
        "kind": {
          "enum": ["instructions", "settings", "hook", "skill", "agent", "mcp_server", "plugin", "harness_lens"]
        },
        "name": { "$ref": "#/$defs/shortText" },
        "origin": { "enum": ["project_shared", "project_local", "user", "managed", "plugin"] },
        "paths": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/relPath" }, "uniqueItems": true },
        "contentHash": { "$ref": "#/$defs/sha256" },
        "attributes": {
          "description": "종류별 구조 사실(이벤트, matcher, model, tools 등). 값은 비밀정보 제거를 거친 짧은 문자열·숫자·불리언만 허용한다.",
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              { "type": "string", "maxLength": 200 },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "null" },
              { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 120 } }
            ]
          }
        }
      }
    },

    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "componentId", "path", "line", "keyPath", "fact", "mechanism", "primaryAxis", "secondaryAxes", "ruleIds", "void", "levelCap"],
      "properties": {
        "id": { "$ref": "#/$defs/evidenceId" },
        "componentId": { "$ref": "#/$defs/componentId" },
        "path": { "$ref": "#/$defs/relPath" },
        "line": { "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }] },
        "keyPath": {
          "description": "JSON·YAML 설정 안의 위치(JSON Pointer). 텍스트 파일이면 null.",
          "type": ["string", "null"],
          "pattern": "^(/[^/]*)*$",
          "maxLength": 200
        },
        "fact": {
          "description": "엔진 템플릿으로 만든 관찰 사실 한 문장. 원문 인용은 비밀정보 제거 후 160자 이하.",
          "$ref": "#/$defs/shortText"
        },
        "mechanism": {
          "description": "강제력 단계. narrative=서술, procedure=Skill·Agent 절차, harness_enforced=Hook·권한 규칙, org_enforced=관리형 설정·sandbox.",
          "enum": ["narrative", "procedure", "harness_enforced", "org_enforced"]
        },
        "primaryAxis": {
          "description": "수준 판정에 쓰는 단 하나의 축. 어느 규칙에도 맞지 않으면 null(미귀속 근거).",
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/axisId" }]
        },
        "secondaryAxes": {
          "description": "참고 표시용. 수준 판정에 쓰지 않는다.",
          "type": "array",
          "items": { "$ref": "#/$defs/axisId" },
          "uniqueItems": true
        },
        "ruleIds": { "type": "array", "items": { "$ref": "#/$defs/ruleId" }, "uniqueItems": true },
        "void": {
          "description": "무력화된 근거(예: disableAllHooks). 무력화되면 수준 판정에서 뺀다.",
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["ruleId", "reason"],
              "properties": { "ruleId": { "$ref": "#/$defs/ruleId" }, "reason": { "$ref": "#/$defs/shortText" } }
            }
          ]
        },
        "levelCap": {
          "description": "참조 무결성 등으로 이 근거가 줄 수 있는 최대 수준.",
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["max", "ruleId"],
              "properties": { "max": { "$ref": "#/$defs/level" }, "ruleId": { "$ref": "#/$defs/ruleId" } }
            }
          ]
        }
      }
    },

    "axisResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "level", "levelStatus", "source", "range", "maturity", "measured"],
      "properties": {
        "axis": { "$ref": "#/$defs/axisId" },
        "level": {
          "description": "구조적 지원 수준(예측). 실제 성능이 아니다. 엔진 규칙으로만 계산한다.",
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/level" }]
        },
        "levelStatus": {
          "description": "assessed: 수준 계산됨. unknown: 관련 출처를 읽지 못해 판정 불가(0으로 대체하지 않음). undefined: 루브릭 기준 없음.",
          "enum": ["assessed", "unknown", "undefined"]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ruleId", "evidenceIds", "capRuleIds"],
          "properties": {
            "ruleId": {
              "description": "수준을 결정한 규칙. 0이면 <PREFIX>-L0-00, 판정 불가면 null.",
              "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/ruleId" }]
            },
            "evidenceIds": { "$ref": "#/$defs/evidenceIds" },
            "capRuleIds": { "type": "array", "items": { "$ref": "#/$defs/ruleId" }, "uniqueItems": true }
          }
        },
        "range": {
          "description": "가능 범위. 수집 범위 밖·미확인 출처가 바꿀 수 있는 최소~최대 수준.",
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max", "reasonCodes"],
          "properties": {
            "min": { "$ref": "#/$defs/level" },
            "max": { "$ref": "#/$defs/level" },
            "reasonCodes": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }, "uniqueItems": true }
          }
        },
        "maturity": { "$ref": "#/$defs/maturity" },
        "measured": {
          "description": "실측 상태일 때만 값이 있다.",
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/measured" }]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "levelStatus": { "const": "assessed" } } },
          "then": { "properties": { "level": { "$ref": "#/$defs/level" }, "source": { "properties": { "ruleId": { "$ref": "#/$defs/ruleId" } } } } },
          "else": { "properties": { "level": { "type": "null" } } }
        },
        {
          "if": { "properties": { "maturity": { "properties": { "state": { "const": "measured" } } } } },
          "then": { "properties": { "measured": { "$ref": "#/$defs/measured" } } },
          "else": { "properties": { "measured": { "type": "null" } } }
        }
      ]
    },

    "maturity": {
      "description": "근거 성숙도(FR-11).",
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "measurable", "requirement", "current", "progress", "blockedReason"],
      "properties": {
        "state": { "enum": ["predicted", "measured"] },
        "measurable": {
          "description": "MVP 1 데이터(세션 기록)로 실측 전환이 가능한 축인가. false면 진행도를 표시하지 않는다.",
          "type": "boolean"
        },
        "requirement": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["unit", "required", "heuristic"],
              "properties": {
                "unit": { "enum": ["sessions", "tool_calls"] },
                "required": { "type": "integer", "minimum": 1 },
                "heuristic": { "type": "boolean" }
              }
            }
          ]
        },
        "current": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/count" }] },
        "progress": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/ratio" }] },
        "blockedReason": {
          "description": "실측 전환이 막힌 이유 코드(예: needs_ci_pr_data, session_format_unsupported, no_session_logs).",
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "measurable": { "const": false } } },
          "then": { "properties": { "state": { "const": "predicted" }, "requirement": { "type": "null" }, "progress": { "type": "null" }, "blockedReason": { "type": "string" } } }
        }
      ]
    },

    "measured": {
      "type": "object",
      "additionalProperties": false,
      "required": ["band", "bandRuleId", "heuristic", "metrics", "predictedLevel", "deltaFromPredicted", "sampleSize"],
      "properties": {
        "band": {
          "description": "실측 지표를 루브릭 임계값으로 0~3에 대응시킨 값. 임계값이 휴리스틱이면 heuristic=true.",
          "$ref": "#/$defs/level"
        },
        "bandRuleId": { "type": "string", "pattern": "^(TP|CE|CX|AU|ES|SB)-M-[0-9]{2}$" },
        "heuristic": { "type": "boolean" },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metricId", "value", "unit"],
            "properties": {
              "metricId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "value": { "type": "number" },
              "unit": { "enum": ["ms", "ratio", "tokens", "count", "per_session"] }
            }
          }
        },
        "predictedLevel": {
          "description": "실측 전환 직전의 구조적 수준(FR-11 이전 예측과의 차이).",
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/level" }]
        },
        "deltaFromPredicted": { "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": -3, "maximum": 3 }] },
        "sampleSize": { "type": "integer", "minimum": 1 }
      }
    },

    "tensionCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tensionId", "kind", "axes", "evidenceIds"],
      "properties": {
        "tensionId": { "type": "string", "pattern": "^[TS][0-9]{1,2}$" },
        "kind": { "enum": ["tension", "synergy"] },
        "axes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/axisId" }
        },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds", "minItems": 1 }
      }
    },

    "tokenBucket": {
      "description": "중복 제거 후 토큰. weighted는 공개 가격표 기준 상대 환산값이며 청구액이 아니다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["freshInput", "cacheWrite", "cacheRead", "output", "weighted"],
      "properties": {
        "freshInput": { "$ref": "#/$defs/count" },
        "cacheWrite": { "$ref": "#/$defs/count" },
        "cacheRead": { "$ref": "#/$defs/count" },
        "output": { "$ref": "#/$defs/count" },
        "weighted": { "type": "number", "minimum": 0 }
      }
    },

    "sessions": {
      "description": "세션 기록 집계(FR-10, PRD 6.1). 숫자만 담는다. 원문·경로 원문·식별자 원문을 담지 않는다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "clientVersions", "window", "coverage", "dedup", "tokens", "contextPerTurn", "axisMetrics", "toolUsage"],
      "properties": {
        "status": { "enum": ["available", "partial", "unavailable", "disabled"] },
        "reason": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*$" },
        "clientVersions": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["min", "max"],
              "properties": { "min": { "type": "string", "maxLength": 40 }, "max": { "type": "string", "maxLength": 40 } }
            }
          ]
        },
        "window": {
          "description": "누적 집계가 덮는 기간. 원본 기록 보존 기간(기본 30일)보다 길 수 있다.",
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to", "rawLogsFrom"],
              "properties": {
                "from": { "$ref": "#/$defs/date" },
                "to": { "$ref": "#/$defs/date" },
                "rawLogsFrom": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/date" }] }
              }
            }
          ]
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filesScanned", "linesRead", "linesSkipped", "skippedRatio", "sessionsAttributed", "sessionsUnattributed", "sessionsExcluded", "incremental", "configSince"],
          "properties": {
            "filesScanned": { "$ref": "#/$defs/count" },
            "linesRead": { "$ref": "#/$defs/count" },
            "linesSkipped": { "$ref": "#/$defs/count" },
            "skippedRatio": { "$ref": "#/$defs/ratio" },
            "sessionsAttributed": { "$ref": "#/$defs/count" },
            "sessionsUnattributed": {
              "description": "귀속이 실제로 불확실한 메인 세션 수(cwd 없음, 매핑·언급 없는 봇). 합계에 넣지 않는다.",
              "$ref": "#/$defs/count"
            },
            "sessionsExcluded": {
              "description": "이 프로젝트와 무관한 것이 확실해 집계에서 뺀 메인 세션 수(다른 프로젝트 cwd, 다른 저장소에 매핑된 봇). 토큰은 어디에도 넣지 않는다.",
              "$ref": "#/$defs/count"
            },
            "incremental": { "type": "boolean" },
            "configSince": {
              "description": "현재 구성 해시가 처음 관측된 시각. 실측 진행도는 이 이후 세션만 센다.",
              "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/dateTime" }]
            }
          }
        },
        "dedup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assistantLines", "uniqueResponses", "excludedSynthetic", "excludedApiError"],
          "properties": {
            "assistantLines": { "$ref": "#/$defs/count" },
            "uniqueResponses": { "$ref": "#/$defs/count" },
            "excludedSynthetic": { "$ref": "#/$defs/count" },
            "excludedApiError": { "$ref": "#/$defs/count" }
          }
        },
        "tokens": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["weighting", "total", "byLocation", "unattributed", "byModel"],
              "properties": {
                "weighting": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["pricingTableVersion", "referenceModel", "basis"],
                  "properties": {
                    "pricingTableVersion": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                    "referenceModel": { "type": "string", "maxLength": 80 },
                    "basis": { "const": "reference_model_fresh_input_equivalent" }
                  }
                },
                "total": {
                  "description": "귀속된 위치 합계. 미귀속은 섞지 않는다.",
                  "$ref": "#/$defs/tokenBucket"
                },
                "byLocation": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["location", "sessions", "tokens", "weightedShare", "attribution"],
                    "properties": {
                      "location": {
                        "description": "direct=프로젝트 세션, worker=워커 워크트리 세션, subagent=서브에이전트 기록, bot=오케스트레이터 봇 채팅.",
                        "enum": ["direct", "worker", "subagent", "bot"]
                      },
                      "sessions": { "$ref": "#/$defs/count" },
                      "tokens": { "$ref": "#/$defs/tokenBucket" },
                      "weightedShare": { "$ref": "#/$defs/ratio" },
                      "attribution": {
                        "description": "귀속 방법별 세션 수. inferred·auto는 추정 귀속이다.",
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["direct", "worktree", "inferred", "configured", "auto"],
                        "properties": {
                          "direct": { "$ref": "#/$defs/count" },
                          "worktree": { "$ref": "#/$defs/count" },
                          "inferred": { "$ref": "#/$defs/count" },
                          "configured": { "$ref": "#/$defs/count" },
                          "auto": { "$ref": "#/$defs/count" }
                        }
                      }
                    }
                  }
                },
                "unattributed": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["sessions", "botSessions", "tokens"],
                  "properties": {
                    "sessions": { "$ref": "#/$defs/count" },
                    "botSessions": { "$ref": "#/$defs/count" },
                    "tokens": { "$ref": "#/$defs/tokenBucket" }
                  }
                },
                "byModel": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["model", "tokens"],
                    "properties": { "model": { "type": "string", "maxLength": 80 }, "tokens": { "$ref": "#/$defs/tokenBucket" } }
                  }
                }
              }
            }
          ]
        },
        "contextPerTurn": {
          "description": "메인 스레드 API 요청 하나의 입력 크기(freshInput+cacheWrite+cacheRead) 분포와 추이. 분포는 최근 원시 응답(보존 기간 안)에서만 정확히 내고, 일별 추이는 archive로 접힌 날까지 잇는다.",
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["requests", "p50", "p90", "max", "firstRequestP50", "distribution", "compactions", "series"],
              "properties": {
                "requests": { "description": "분포에 쓴 최근 원시 요청 수.", "$ref": "#/$defs/count" },
                "p50": { "description": "최근 원시 요청이 없으면 null(미확인).", "anyOf": [{ "$ref": "#/$defs/count" }, { "type": "null" }] },
                "p90": { "anyOf": [{ "$ref": "#/$defs/count" }, { "type": "null" }] },
                "max": { "anyOf": [{ "$ref": "#/$defs/count" }, { "type": "null" }] },
                "firstRequestP50": { "anyOf": [{ "$ref": "#/$defs/count" }, { "type": "null" }] },
                "distribution": {
                  "description": "분포(p50·p90·max·firstRequestP50)를 계산한 최근 원시 응답의 날짜 범위. 없으면 from·to가 null.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["from", "to", "retentionDays"],
                  "properties": {
                    "from": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
                    "to": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
                    "retentionDays": { "$ref": "#/$defs/count" }
                  }
                },
                "compactions": { "$ref": "#/$defs/count" },
                "series": {
                  "description": "일별 추이. 최대 90점. source가 archive인 날은 접힌 요약이라 p50이 근사일 수 있다(requests·max는 정확).",
                  "type": "array",
                  "maxItems": 90,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["date", "requests", "p50", "max", "source"],
                    "properties": {
                      "date": { "$ref": "#/$defs/date" },
                      "requests": { "$ref": "#/$defs/count" },
                      "p50": { "$ref": "#/$defs/count" },
                      "max": { "$ref": "#/$defs/count" },
                      "source": { "enum": ["raw", "archive"] }
                    }
                  }
                }
              }
            }
          ]
        },
        "toolUsage": {
          "description": "configSince 이후 프로젝트·워커 세션(서브에이전트 포함)의 도구 분류별 호출·오류 수(루브릭 §1.9, 0.3). 내장 도구는 이름, MCP 도구는 mcp, 그 밖은 other, 결과의 호출을 찾지 못하면 unknown.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool", "calls", "errors"],
            "properties": {
              "tool": { "type": "string", "pattern": "^(?:[A-Z][A-Za-z]{1,39}|mcp|other|unknown)$" },
              "calls": { "$ref": "#/$defs/count" },
              "errors": { "$ref": "#/$defs/count" }
            }
          }
        },
        "axisMetrics": {
          "description": "축별 실측 후보 지표(성숙도 진행과 무관하게 관측값을 모두 담는다).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["axis", "metricId", "value", "unit", "sampleSize", "sinceConfig"],
            "properties": {
              "axis": { "$ref": "#/$defs/axisId" },
              "metricId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "value": { "type": "number" },
              "unit": { "enum": ["ms", "ratio", "tokens", "count", "per_session"] },
              "sampleSize": { "$ref": "#/$defs/count" },
              "sinceConfig": {
                "description": "true면 configSince 이후 세션만으로 계산한 값.",
                "type": "boolean"
              }
            }
          }
        }
      }
    },

    "selfCost": {
      "description": "Harness Lens 자기 비용(PRD 11.1).",
      "type": "object",
      "additionalProperties": false,
      "required": ["componentId", "alwaysLoadedTokens", "currentRun", "previousAnalysis", "budgets"],
      "properties": {
        "componentId": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/componentId" }] },
        "alwaysLoadedTokens": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "method"],
          "properties": {
            "value": { "$ref": "#/$defs/count" },
            "method": { "enum": ["estimate_utf8_bytes", "reported_by_agent"] }
          }
        },
        "currentRun": {
          "description": "이번 분석의 엔진 실행 기록. LLM 토큰은 다음 분석에서 previousAnalysis로 측정한다.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subcommand", "durationMs", "maxRssBytes"],
            "properties": {
              "subcommand": { "enum": ["check-runtime", "collect", "aggregate-sessions", "prepare", "validate", "snapshot", "diff", "render", "finalize"] },
              "durationMs": { "$ref": "#/$defs/count" },
              "maxRssBytes": { "$ref": "#/$defs/count" }
            }
          }
        },
        "previousAnalysis": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["snapshotId", "wallClockMs", "llmTokens", "method"],
              "properties": {
                "snapshotId": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$" },
                "wallClockMs": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/count" }] },
                "llmTokens": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/tokenBucket" }] },
                "method": { "enum": ["session_window", "unknown"] }
              }
            }
          ]
        },
        "budgets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["budgetId", "target", "unit", "observed", "status"],
            "properties": {
              "budgetId": {
                "enum": ["always_loaded_tokens", "background_processes", "reanalysis_engine_ms", "engine_max_rss_bytes", "llm_input_inventory_tokens", "llm_tokens_per_analysis"]
              },
              "target": { "type": "number", "minimum": 0 },
              "unit": { "enum": ["tokens", "count", "ms", "bytes"] },
              "observed": { "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0 }] },
              "status": { "enum": ["within", "exceeded", "unmeasured"] }
            }
          }
        }
      }
    },

    "comparison": {
      "description": "이전 스냅샷과의 결정론적 비교(FR-06).",
      "type": "object",
      "additionalProperties": false,
      "required": ["previousSnapshotId", "previousAnalyzedAt", "comparability", "limitations", "componentChanges", "axisDeltas"],
      "properties": {
        "previousSnapshotId": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$" },
        "previousAnalyzedAt": { "$ref": "#/$defs/dateTime" },
        "comparability": {
          "description": "full: 같은 스키마·루브릭·범위. limited: 일부 축·지표만 비교 가능. none: 비교 불가(목록만 표시).",
          "enum": ["full", "limited", "none"]
        },
        "limitations": { "type": "array", "items": { "$ref": "#/$defs/notice" } },
        "componentChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["changeId", "componentId", "kind", "name", "change", "paths"],
            "properties": {
              "changeId": { "$ref": "#/$defs/changeId" },
              "componentId": {
                "description": "현재 구성 요소 ID. removed면 이전 스냅샷의 ID.",
                "$ref": "#/$defs/componentId"
              },
              "kind": { "enum": ["instructions", "settings", "hook", "skill", "agent", "mcp_server", "plugin", "harness_lens"] },
              "name": { "$ref": "#/$defs/shortText" },
              "change": {
                "description": "unknown: 한쪽 스냅샷에서 출처를 읽지 못해 판정할 수 없음.",
                "enum": ["added", "removed", "modified", "unknown"]
              },
              "paths": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/relPath" }, "uniqueItems": true }
            }
          }
        },
        "axisDeltas": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["axis", "previousLevel", "currentLevel", "previousState", "currentState", "comparable", "reason"],
            "properties": {
              "axis": { "$ref": "#/$defs/axisId" },
              "previousLevel": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/level" }] },
              "currentLevel": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/level" }] },
              "previousState": { "enum": ["predicted", "measured"] },
              "currentState": { "enum": ["predicted", "measured"] },
              "comparable": { "type": "boolean" },
              "reason": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*$" }
            }
          }
        }
      }
    },

    "interpretation": {
      "$comment": "사용자 LLM 작성. 엔진 값을 복사하거나 바꾸지 않는다. 수준·범위·지표 필드가 없다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "components", "findings", "axisNotes", "currentTradeoffs", "changeTradeoffs", "limitations"],
      "properties": {
        "summary": {
          "description": "에이전트 마지막 응답과 리포트 상단에 쓰는 요약. 세 줄 이내.",
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "components": {
          "description": "FR-03 구성 요소별 역할·의도·의존 관계·위험.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["componentId", "role", "intent", "dependsOn", "risks", "confidence"],
            "properties": {
              "componentId": { "$ref": "#/$defs/componentId" },
              "role": { "$ref": "#/$defs/shortText" },
              "intent": { "$ref": "#/$defs/text" },
              "dependsOn": { "type": "array", "items": { "$ref": "#/$defs/componentId" }, "uniqueItems": true },
              "risks": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
              "confidence": { "$ref": "#/$defs/confidence" }
            }
          }
        },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "axisNotes": {
          "description": "축 상세(PRD 8.1). 축마다 하나.",
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["axis", "rationale", "conditions", "counterexamples", "validation"],
            "properties": {
              "axis": { "$ref": "#/$defs/axisId" },
              "rationale": { "$ref": "#/$defs/text" },
              "conditions": { "type": "array", "items": { "$ref": "#/$defs/shortText" } },
              "counterexamples": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/shortText" } },
              "validation": { "type": "array", "items": { "$ref": "#/$defs/shortText" } }
            }
          }
        },
        "currentTradeoffs": { "$ref": "#/$defs/currentTradeoffs" },
        "changeTradeoffs": {
          "description": "FR-07b. engine.comparison이 없으면 null.",
          "anyOf": [{ "type": "null" }, { "type": "array", "items": { "$ref": "#/$defs/changeTradeoff" } }]
        },
        "limitations": { "type": "array", "items": { "$ref": "#/$defs/text" } }
      }
    },

    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidenceIds"],
      "properties": {
        "text": { "$ref": "#/$defs/shortText" },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
      }
    },

    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "axis", "componentIds", "status", "direction", "statement", "evidenceIds", "metricRefs", "condition", "confidence", "validation", "unknownReason"],
      "properties": {
        "id": { "type": "string", "pattern": "^f[0-9]{1,3}$" },
        "axis": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/axisId" }] },
        "componentIds": { "type": "array", "items": { "$ref": "#/$defs/componentId" }, "uniqueItems": true },
        "status": {
          "description": "observed=근거에서 직접 확인, inferred=근거+지식 베이스에서 도출한 조건부 영향, measured=세션 집계 지표 인용, unknown=근거 부족.",
          "enum": ["observed", "inferred", "measured", "unknown"]
        },
        "direction": { "enum": ["potential_positive", "potential_negative", "mixed", "neutral", "unknown"] },
        "statement": { "$ref": "#/$defs/text" },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" },
        "metricRefs": {
          "description": "engine.sessions.axisMetrics의 metricId.",
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "uniqueItems": true
        },
        "condition": {
          "description": "이 판단이 성립하는 조건. observed·measured는 null 가능.",
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/shortText" }]
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "validation": {
          "description": "사용자가 판단을 확인할 방법.",
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/shortText" }]
        },
        "unknownReason": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/shortText" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "observed" } } },
          "then": { "properties": { "evidenceIds": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "inferred" } } },
          "then": {
            "properties": {
              "evidenceIds": { "minItems": 1 },
              "condition": { "$ref": "#/$defs/shortText" },
              "validation": { "$ref": "#/$defs/shortText" },
              "confidence": { "enum": ["low", "medium"] }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "measured" } } },
          "then": { "properties": { "metricRefs": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "unknown" } } },
          "then": { "properties": { "unknownReason": { "$ref": "#/$defs/shortText" }, "direction": { "const": "unknown" } } },
          "else": { "properties": { "unknownReason": { "type": "null" } } }
        }
      ]
    },

    "currentTradeoffs": {
      "description": "FR-07a. 이전 스냅샷 없이도 항상 작성한다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["investForgo", "componentTradeoffs", "axisTensions", "emptyAreas"],
      "properties": {
        "investForgo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "invested", "forgone", "evidenceIds"],
          "properties": {
            "summary": { "type": "string", "minLength": 1, "maxLength": 160 },
            "invested": { "type": "array", "items": { "$ref": "#/$defs/axisId" }, "uniqueItems": true },
            "forgone": { "type": "array", "items": { "$ref": "#/$defs/axisId" }, "uniqueItems": true },
            "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
          }
        },
        "componentTradeoffs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["componentId", "gains", "costs", "confidence"],
            "properties": {
              "componentId": { "$ref": "#/$defs/componentId" },
              "gains": { "type": "array", "items": { "$ref": "#/$defs/axisEffect" } },
              "costs": { "type": "array", "items": { "$ref": "#/$defs/axisEffect" } },
              "confidence": { "$ref": "#/$defs/confidence" }
            }
          }
        },
        "axisTensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tensionId", "explanation", "evidenceIds", "condition", "confidence"],
            "properties": {
              "tensionId": {
                "description": "engine.tensionCandidates[].tensionId 중 하나.",
                "type": "string",
                "pattern": "^[TS][0-9]{1,2}$"
              },
              "explanation": { "$ref": "#/$defs/text" },
              "evidenceIds": { "$ref": "#/$defs/evidenceIds", "minItems": 1 },
              "condition": { "$ref": "#/$defs/shortText" },
              "confidence": { "$ref": "#/$defs/confidence" }
            }
          }
        },
        "emptyAreas": {
          "description": "수준 0(미구성) 또는 판정 불가(미확인) 축 각각에 대한 의미. 엔진 결과와 일치해야 한다.",
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["axis", "kind", "meaning", "howToConfirm"],
            "properties": {
              "axis": { "$ref": "#/$defs/axisId" },
              "kind": { "enum": ["unconfigured", "unknown"] },
              "meaning": { "$ref": "#/$defs/shortText" },
              "howToConfirm": { "$ref": "#/$defs/shortText" }
            }
          }
        }
      }
    },

    "axisEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "text", "evidenceIds"],
      "properties": {
        "axis": { "$ref": "#/$defs/axisId" },
        "text": { "$ref": "#/$defs/shortText" },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds", "minItems": 1 }
      }
    },

    "changeTradeoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changeIds", "expectedEffects", "potentialLosses", "unknownImpacts", "validation", "multiChangeCaveat"],
      "properties": {
        "changeIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/changeId" }, "uniqueItems": true },
        "expectedEffects": { "type": "array", "items": { "$ref": "#/$defs/changeEffect" } },
        "potentialLosses": { "type": "array", "items": { "$ref": "#/$defs/changeEffect" } },
        "unknownImpacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["axis", "text"],
            "properties": {
              "axis": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/axisId" }] },
              "text": { "$ref": "#/$defs/shortText" }
            }
          }
        },
        "validation": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/shortText" } },
        "multiChangeCaveat": {
          "description": "여러 구성 요소가 함께 바뀌어 개별 효과를 확정할 수 없으면 true(PRD 7.3).",
          "type": "boolean"
        }
      }
    },

    "changeEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "direction", "text", "evidenceIds", "condition", "confidence"],
      "properties": {
        "axis": { "$ref": "#/$defs/axisId" },
        "direction": { "enum": ["increase", "decrease", "unclear"] },
        "text": { "$ref": "#/$defs/shortText" },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds", "minItems": 1 },
        "condition": { "$ref": "#/$defs/shortText" },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },

    "validation": {
      "$comment": "엔진 작성. 스키마 검사는 이 속성을 뺀 문서에 대해 수행한 뒤 결과를 여기에 기록한다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "validatorVersion", "checkedAt", "checks"],
      "properties": {
        "status": { "enum": ["valid", "invalid"] },
        "validatorVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
        "checkedAt": { "$ref": "#/$defs/dateTime" },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["checkId", "status", "message"],
            "properties": {
              "checkId": { "type": "string", "pattern": "^V-[A-Z0-9-]+$" },
              "status": { "enum": ["pass", "fail", "warn"] },
              "message": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }] }
            }
          }
        }
      }
    }
  }
}
